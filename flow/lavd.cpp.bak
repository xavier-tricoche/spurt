template<typename T, size_t N>
std::ostream& operator<<(std::ostream& os, const std::array<T, N>& a) {
	os << "[" << a[0];
	for (int i=1; i<N; ++i) {
		os << ", " << a[i];
	}
	os << "]";
	return os;
}

