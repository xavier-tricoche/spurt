inline vec3 append(const vec2& v, value_t t) {
    return vec3(v[0], v[1], t);
}

void set_verbose_values() {
    if (verbose_vec.size()<1 || verbose_vec.size()>2) {
        throw std::runtime_error("Invalid verbose values");
    }
    verbose_cout = verbose_vec[0];
    if (verbose_vec.size()==1) {
        verbose_log = verbose_cout;
    }
    else verbose_log = verbose_vec[1];
    _log_(0) << "verbose_cout=" << verbose_cout << ", verbose_log="
        << verbose_log << std::endl;
}

void parse_restart_file() {
	_log_(2) << "parsing restart file" << std::endl;
	Nrrd* nin = spurt::nrrd_utils::readNrrd(restart_name);
	spurt::nrrd_utils::nrrd_traits traits(nin);
    //Use designated resolution, don't use file resolution
    //res[0] = traits.sizes()[1];
    //res[1] = traits.sizes()[2];
    nb_samples = traits.sizes()[2];

	std::cout << "resolution: " << res[0] << " x " << res[1] << std::endl;

	const std::vector<std::string>& comments = traits.comments();
	std::cout << "There are " << comments.size() << " lines of comments" << std::endl;

	std::string param, val_as_str;

	std::regex line_regex("[ ]*\\*[ ]*(.*)[ ]*=[ ]*(.*)$"); // "* <what>=<value>"
	std::regex res_regex("(.*)[ ]*x[ ]*(.*)$");
	std::regex bnd_regex("(.*)[ ]*->[ ]*(.*)$");
	std::smatch line_match, res_match, bnd_match;
	for (int i=0; i<comments.size(); ++i) { // skip first 2 lines of comments
		const std::string& c = comments[i];
		if (std::regex_search(c, line_match, line_regex)) {
			param = line_match[1].str();
			val_as_str = line_match[2].str();
		}
		else {
			std::cout << "skipping comment line: " << c << std::endl;
			continue;
		}
		std::cout << "parameter: " << param << ", value: " << val_as_str << std::endl;
		if (param == "input file") name_in = val_as_str;
		else if (param == "current time" || param == "tmax") t_init = std::stod(val_as_str);
		else if (param == "epsilon") eps = std::stod(val_as_str);
		else if (param == "resolution") {
			if (std::regex_search(val_as_str, res_match, res_regex)) {
                //Use designated resolution, don't use file resolution
				res[0] = std::stoi(res_match[1].str());
				res[1] = std::stoi(res_match[2].str());
			}
			else throw std::runtime_error("invalid resolution syntax in restart file");
		}
		else if (param == "bounds") {
			if (std::regex_search(val_as_str, bnd_match, bnd_regex)) {
				std::istringstream iss1(bnd_match[1].str());
				nvis::vec2 x;
				iss1 >> x;
				bnds[0] = x[0];
				bnds[1] = x[1];
				std::istringstream iss2(bnd_match[2].str());
				iss2 >> x;
				bnds[2] = x[0];
				bnds[3] = x[1];
			}
			else throw std::runtime_error("invalid bounds syntax in restart file");
		}
		else if (param == "dt") dt = std::stod(val_as_str);
		else {
			std::cout << "skipping value assignment for " << param << std::endl;
			continue;
		}
	}

	std::cout << "imported parameters:\n";
	std::cout << "name_in=" << name_in << '\n';
	std::cout << "t_init=" << t_init << '\n';
	std::cout << "epsilon=" << eps << '\n';
	std::cout << "resolution=" << res << '\n';
	std::cout << "bounds=" << bnds << '\n';
	std::cout << "dt=" << dt << '\n';

	nrrdNuke(nin); // we will reopen the file later to access particle coordinates
}

void initialize(int argc, const char* argv[])
{
    namespace xcl = spurt::command_line;

    xcl::option_traits
            required(true, false, "Required Options"),
            optional(false, false, "Optional Group");
    xcl::option_parser parser(argv[0],
            "Compute Lagrangian averaged vorticity deviation");

    verbose_vec.resize(2);
    verbose_vec[0] = verbose_cout;
    verbose_vec[1] = verbose_log;

    try {
        parser.use_short_symbols(true);
        parser.use_brackets(true);
        parser.add_value("input", name_in, "Input info filename", optional);
        parser.add_value("output", name_out, "Output file basename ", required);
		parser.add_value("restart", restart_name, "Restart filename", optional);
        parser.add_sequence("tinit", t_init_str, t_init_str, "Integration starting time, expressed either in time since initial time step (in seconds; for minutes append \"m\", for hours \"h\", for days \"d\", for weeks \"w\") or as a date MM/DD", optional, "<float>[<char>]");
        parser.add_value("tmax", t_max_str, "Integration ending time (in seconds; for minutes append \"m\", for hours \"h\", for days \"d\", for weeks \"w\")", optional, "<float>[<char>]");
        parser.add_value("step", t_expstp_str, t_expstp_str, "Time interval between intermediate result outputs", optional);
        parser.add_value("skip", t_skip_str, t_skip_str, "Time skipped before first output", optional);
        parser.add_value("dt", dt_str, dt_str, "Time sampling of integral curve for LAVD computation (in seconds, for minutes add \"m\", for hours \"h\", for times \"x\")", optional, "<float>[<char>]");
        parser.add_tuple<2>("res", res, res, "Sampling resolution", optional);
        parser.add_tuple<4>("bounds", bnds, bnds, "Sampling bounds (min longitude and latitude followed by max's)", optional);
        parser.add_value("nslices", nslices, nslices, "Number of time steps to process simultaneously", optional);
        parser.add_value("eps", eps, eps, "Integration precision", optional);
        parser.add_value("mask", border_mask_name, border_mask_name, "Mask filename", optional);
        parser.add_value("max", max_rhs_evals, max_rhs_evals, "Maximum authorized number of rhs evaluations during intermediate steps of the integration");
        parser.add_value("export", export_region, export_region, "Export index range of selected region", optional);
        parser.add_value("traj", export_trajectories, export_trajectories, "Export trajectories", optional);
        parser.add_value("log", log_name, log_name, "Log export filename", optional);
        parser.add_sequence("verbose", verbose_vec, verbose_vec, "Verbosity level(s) on stdout and log file", optional, "<uint> [<uint>]");
        parser.add_value("lname", long_name, long_name, "Export result with long name indicating computation parameters", optional);

        parser.parse(argc, argv);
        validate_value_with_time_unit(t_max, t_max_str, false);
        validate_value_with_time_unit(dt, dt_str, true);
        validate_value_with_time_unit(t_export_step, t_expstp_str, false);
        std::string t_init_single_str;
        for (auto it=t_init_str.begin(); it!=t_init_str.end(); ++it) {
            t_init_single_str.append(*it);
        }
        try {
            validate_value_with_time_unit(t_init, t_init_single_str);
        }
        catch(...) {
            validate_date_string(t_init, t_init_single_str);
        }
        validate_value_with_time_unit(t_skip, t_skip_str, false);
        set_verbose_values();
		if (!restart_name.empty()) { // input file will override existing values
			_log_(1) << "Restart file provided: " << restart_name << std::endl;
			parse_restart_file();
		}
		if (name_in.empty()) {
			std::cerr << "ERROR: " << argv[0] << ": Neither input file nor restart file have been provided.\n";
			exit(1);
		}
    }
    catch(std::runtime_error& e) {
        std::cerr << "ERROR: " << argv[0] << " threw exception:\n"
                  << e.what() << "\n"
                  << "Command line options entered so far:\n"
                  << parser.print_self(false, true, false) << "\n\n\n";
        exit(1);
    }
}

// global static data storage for parallel computation
Nrrd* current_velocity_volume=0;
Nrrd* current_vorticity_volume=0;
Nrrd* current_average_vorticity_vector=0;
Nrrd* border_mask=0;
value_t current_t_min; // starting time
value_t current_t_max; // stopping time

inline void nuke_current_volumes() {
    if (current_velocity_volume != NULL) {
        nrrdNuke(current_velocity_volume);
    }
    if (current_vorticity_volume != NULL) {
        nrrdNuke(current_vorticity_volume);
    }
    if (current_average_vorticity_vector != NULL) {
        nrrdNuke(current_average_vorticity_vector);
    }
}

void clean_exit(int n) {
    if (log_file.is_open()) log_file.close();
    nuke_current_volumes();
    exit(n);
}

struct observer
{
    LAVD_state& m_state;
    std::vector< vec2 >& m_pos;
    NrrdScalarField<1>& m_avg_vort;
    NrrdScalarField<3>& m_vort;

    value_t vorticity_deviation(const vec2& x, value_t t) {
        try {
            //return 1;
            value_t w = m_vort( vec3(x[0], x[1], t ) );
            value_t aw = m_avg_vort( vec1(t) );
            //return fabs(w-aw);
            return w - aw;
        }
        catch (std::exception& e) {
            _log_(1) << "exception caught in vorticity_deviation:\n"
                    << e.what() << std::endl;
            //printf("%lf %lf\n", x[0], x[1]);
            //fflush(stdout);
            return 0;
            throw;
        }
    }

    observer(LAVD_state& state, std::vector<vec2>& pos,
             NrrdScalarField<3>& vorticity, NrrdScalarField<1>& average_vorticity)
        : m_state(state), m_pos(pos), m_vort(vorticity),
          m_avg_vort(average_vorticity) {}

    void initialize(const vec2& p0, value_t t0) {
        value_t vd0 = vorticity_deviation(p0, t0);
        m_state = LAVD_state(p0, vd0, t0);
        m_pos.clear();
        m_pos.push_back(p0);

        m_state.meta_lifetime = 0;

        m_state.birth_time = t0;
        m_state.birth_value = m_state.m_acc_vd;
        //#pragma omp critical
        m_state.unique_id = global_identifier++;
    }

    void operator()(const vec2 &x, value_t t)
    {
        // save latest position: if trajectories are not exported
        // we only retain the latest position for flow map
        // computation purposes
        if (export_trajectories) m_pos.push_back(x);
        else m_pos.back() = x;

        value_t vd = vorticity_deviation(x, t);
        m_state.update(x, vd, t);
        /*_log_(1) << "LAVD(" << t << ")=" << m_state.evaluate()
            << " (vd=" << vd << ")" << std::endl;*/
    }
};

std::vector< std::vector< vec2 > > all_trajectories;
std::vector< LAVD_state > all_states;


void import_data(const std::vector< std::string >& vel_filenames,
                 const std::vector< std::string >& vor_filenames,
                 size_t start_id)
{
    // for (size_t i=0; i<vel_filenames.size(); ++i) {
    //     std::cout << "filename[" << i << "]=" << vel_filenames[i] << '\n';
    // }

    //printf("%ld\n", vel_filenames.size());
    size_t n_available = std::min(nslices, vel_filenames.size()-start_id+support_radius);
    size_t n_used = std::min(n_available, static_cast<size_t>((t_max-t_init)/t_between_files+2*support_radius));
    //printf("n_available: %ld, t_max: %lf, t_init: %lf\n", n_available, t_max, t_init);
    //printf("n_used: %ld\n", n_used);
    _log_(1)
        << "import_data: start_id=" << start_id
        << ", #filenames=" << vel_filenames.size()
        << ", n_available=" << n_available
        << ", (tmax-tinit)/t_between_files=" << (t_max-t_init)/t_between_files
        << ", number of time steps needed to complete entire integration length="
        << static_cast<size_t>((t_max-t_init)/t_between_files+2*support_radius)
        << ", n_used=" << n_used << std::endl;

    nuke_current_volumes();

    // initialize velocity and vorticity volumes
    std::vector< Nrrd* > vel_tsteps(n_used);
    std::vector< Nrrd* > vor_tsteps(n_used);
    printf("Start id: %ld\n", start_id);
    size_t first = ( start_id >= support_radius ? start_id-support_radius : static_cast<size_t>(0) );
    //printf("First: %ld\n", first);
    printf("Importing: %ld - %ld\n", first, first + n_used - 1);
    import_start = first;
    current_t_min = start_id * t_export_step;
    for (size_t i=first; i<first+n_used; ++i) {
        _log_(1) << "Reading " << vel_filenames[i] << "... " << std::flush;
        vel_tsteps[i-first]=spurt::nrrd_utils::readNrrd(vel_filenames[i]);
        _log_(1) << "done" << std::endl;
        print(vel_tsteps[i-first]);

        _log_(1) << "Reading " << vor_filenames[i] << "... " << std::flush;
        vor_tsteps[i-first]=spurt::nrrd_utils::readNrrd(vor_filenames[i]);
		_log_(1) << "printing contents of vorticity input Nrrd #" << i << "\n";
		print(vor_tsteps[i-first]);
        _log_(1) << "done" << std::endl;
        //Check for negative vorticities
        //size_t totalElements = vor_tsteps[i-first]->axis[0].size * vor_tsteps[i - first]->axis[1].size;
        //printf("totalElements: %ld\n", totalElements);
        //for (size_t idx = 0; idx < totalElements; ++idx) {
        //    value_t value = nrrd_value(vor_tsteps[i-first], idx);
        //    printf("%lf\n", value);
        //}
    }
    last_time_step = first + n_used - 1;
    value_t outer_tmin = /*t_init +*/ first*t_between_files;
    _log_(2) << "outer_tmin=" << outer_tmin << std::endl;
    current_velocity_volume = spurt::lavd::create_nrrd_volume(vel_tsteps, outer_tmin, t_between_files);
    _log_(2) << "after velocity volume creation:" << std::endl;
    print(current_velocity_volume);

    // clean up
    for (size_t i=0; i<vel_tsteps.size(); ++i) {
        nrrdNuke(vel_tsteps[i]);
    }

    current_vorticity_volume = spurt::lavd::create_nrrd_volume(vor_tsteps, outer_tmin, t_between_files);
    //Check for negative vorticities
    //size_t totalElements = current_vorticity_volume->axis[0].size * current_vorticity_volume->axis[1].size;
    //printf("totalElements: %ld\n", totalElements);
    //for (size_t idx = 0; idx < totalElements; ++idx) {
    //    value_t value = nrrd_value(current_vorticity_volume, idx);
    //    printf("%lf\n", value);
    //}
    //current_t_min = start_id*t_between_files;
    // if (outer_tmin > t_init) {
    //     current_t_min += support_radius*t_between_files;
    // }
    current_t_max = last_time_step*t_between_files;
    if (current_t_max < t_max) current_t_max -= support_radius*t_between_files;
    else current_t_max = t_max;
    _log_(1)
        << "n_used=" << n_used << '\n'
        << "support_radius=" << support_radius << '\n'
        << "current_t_max=" << current_t_max << '\n';

    _log_(1)
        << "selected region = " << region << '\n'
        << "x spacing: " << input_spc[0] << '\n'
        << "y spacing: " << input_spc[1] << std::endl;

    // compute average vorticity for selected region
    value_t* av_array = (value_t *)calloc(n_used, sizeof(value_t));
    value_t region_size = region.size()[0]*region.size()[1];
    _log_(1) << "sampling vorticity slices" << std::endl;

    size_t nx = vor_tsteps[0]->axis[0].size;
    size_t ny = vor_tsteps[0]->axis[1].size;
    value_t minx = domain.min()[0];
    value_t miny = domain.min()[1];
    value_t dx = input_spc[0];
    value_t dy = input_spc[1];

    _log_(1) << "nx=" << nx << ", ny=" << ny << '\n';
    _log_(1) << "minx=" << minx << ", mimy=" << miny << '\n';
    _log_(1) << "dx=" << dx << ", dy=" << dy << '\n';

    double min_offset_x = region.min()[0]-minx;
    double min_offset_y = region.min()[1]-miny;
    double max_offset_x = region.max()[0]-minx;
    double max_offset_y = region.max()[1]-miny;
    _log_(1) << "min offset x=" << min_offset_x << '\n';
    _log_(1) << "min offset y=" << min_offset_y << '\n';
    _log_(1) << "max offset x=" << max_offset_x << '\n';
    _log_(1) << "max offset y=" << max_offset_y << std::endl;

    size_t mini = min_offset_x <= 0 ? 0 : static_cast<size_t>(min_offset_x/dx);
    size_t minj = min_offset_y <= 0 ? 0 : static_cast<size_t>(min_offset_y/dy);
    size_t maxi = max_offset_x <= 0 ? 0 : std::min(static_cast<size_t>(max_offset_x/dx), nx-1);
    size_t maxj = max_offset_y <= 0 ? 0 : std::min(static_cast<size_t>(max_offset_y/dy), ny-1);

    if (mini>=nx || mini>maxi) _log_(1) << "invalid mini value: " << mini << std::endl;
    if (minj>=ny || minj>maxj) _log_(1) << "invalid minj value: " << minj << std::endl;
    if (maxi>=nx) _log_(1) << "invalid maxi value: " << maxi << std::endl;
    if (maxj>=ny) _log_(1) << "invalid maxj value: " << maxj << std::endl;
    size_t nsamples = (maxi-mini+1)*(maxj-minj+1);

    _log_(1)
        << "index range for selected region: ["
        << mini << ", " << maxi << "] x ["
        << minj << ", " << maxj << "]" << std::endl;

    spurt::ProgressDisplay progress(false);
    progress.start(n_used*nsamples, "avg. vort.");
    progress.set_active(true);
    size_t base_n=0;
    size_t ncols=maxi-mini+1;
    for (size_t n=0; n<n_used; ++n, base_n+=nsamples) {
        size_t nvalid_samples=0;
        value_t sum=0;
        #pragma omp parallel
        {
            #pragma omp for schedule(dynamic,1)
            for (size_t k=0; k<nsamples; ++k) {
                #if _OPENMP
                const int thread=omp_get_thread_num();
                #else
                const int thread=0;
                #endif

                if (!thread) progress.update(base_n+k);
                int j=k/ncols;
                int i=k%ncols;

                size_t id=(minj+j)*nx+(mini+i);

                if (nrrd_value(border_mask, id) != 0) {
                    value_t vort=nrrd_value(vor_tsteps[n], id);
                    #pragma omp atomic
                    sum += vort;
                    #pragma omp atomic
                    ++nvalid_samples;
                }
            }
        }
        av_array[n] = sum/static_cast<value_t>(nvalid_samples);
        _log_(1) << std::setprecision(12) << "average vorticity[" << n << "]=" << av_array[n] << std::endl;
        _log_(1) << "nsamples=" << nsamples << ", nvalid_samples=" << nvalid_samples << std::endl;
    }
	progress.end();

    Nrrd* av=nrrdNew();
    if (nrrdWrap_nva(av, av_array, spurt::nrrd_utils::nrrd_value_traits_from_type<value_t>::index,
                     1, &n_used)) {
        throw std::runtime_error(spurt::nrrd_utils::error_msg("unable to create 1D average vorticity nrrd"));
    }
    // Per-axis info
    int center = nrrdCenterNode;
    nrrdAxisInfoSet_nva(av, nrrdAxisInfoSpacing, &t_between_files);
    nrrdAxisInfoSet_nva(av, nrrdAxisInfoMin, &outer_tmin);
    nrrdAxisInfoSet_nva(av, nrrdAxisInfoCenter, &center);
    current_average_vorticity_vector = NrrdScalarField<1>::make3d(av);

    // clean up
    for (size_t i=0; i<vor_tsteps.size(); ++i) {
        nrrdNuke(vor_tsteps[i]);
    }
nrrdNuke(av);
}

void local_import(const std::vector< std::string >& vel_filenames,
    const std::vector< std::string >& vor_filenames,
    size_t start_id, size_t max_id,
    Nrrd* &backwards_velocity_volume,
    Nrrd* &backwards_vorticity_volume,
    value_t &current_t_max,
    Nrrd* &current_average_vorticity_vector,
    size_t &last_time_step) {

    if ((int)start_id < 0) start_id = 0;

    size_t n_available = std::min(nslices, (max_id) - start_id + support_radius);
    size_t n_used = std::min(n_available, static_cast<size_t>((t_max - t_init) / t_between_files + 2 * support_radius));
    //printf("n_used: %ld\n", n_used);
    _log_(1)
        << "import_data: start_id=" << start_id
        << ", #filenames=" << vel_filenames.size()
        << ", n_available=" << n_available
        << ", (tmax-tinit)/t_between_files=" << (t_max - t_init) / t_between_files
        << ", number of time steps needed to complete entire integration length="
        << static_cast<size_t>((t_max - t_init) / t_between_files + 2 * support_radius)
        << ", n_used=" << n_used << std::endl;
    //nuke_current_volumes();

    // initialize velocity and vorticity volumes
    std::vector< Nrrd* > vel_tsteps(n_used);
    std::vector< Nrrd* > vor_tsteps(n_used);
    size_t first = (start_id >= support_radius ? start_id - support_radius : static_cast<size_t>(0));
    //printf("Importing: %ld - %ld\n", first, first+n_used-1);
    //printf("Importing files from %ld - %ld for backwards integration (start_id %ld)\n", first, first + n_used, start_id);

    for (size_t i = first; i < first + n_used; ++i) {
        _log_(1) << "Reading " << vel_filenames[i] << "... " << std::flush;
        vel_tsteps[i - first] = spurt::nrrd_utils::readNrrd(vel_filenames[i]);
        _log_(1) << "done" << std::endl;
        print(vel_tsteps[i - first]);

        _log_(1) << "Reading " << vor_filenames[i] << "... " << std::flush;
        vor_tsteps[i - first] = spurt::nrrd_utils::readNrrd(vor_filenames[i]);
        _log_(1) << "printing contents of vorticity input Nrrd #" << i << "\n";
        print(vor_tsteps[i - first]);
        _log_(1) << "done" << std::endl;
        //Check for negative vorticities
        //size_t totalElements = vor_tsteps[i-first]->axis[0].size * vor_tsteps[i - first]->axis[1].size;
        //printf("totalElements: %ld\n", totalElements);
        //for (size_t idx = 0; idx < totalElements; ++idx) {
        //    value_t value = nrrd_value(vor_tsteps[i-first], idx);
        //    printf("%lf\n", value);
        //}
    }
    last_time_step = first + n_used - 1;
    value_t outer_tmin = /*t_init +*/ first * t_between_files;
    _log_(2) << "outer_tmin=" << outer_tmin << std::endl;
    backwards_velocity_volume = spurt::lavd::create_nrrd_volume(vel_tsteps, outer_tmin, t_between_files);
    _log_(2) << "after velocity volume creation:" << std::endl;
    //print(current_velocity_volume);

    // clean up
    for (size_t i = 0; i < vel_tsteps.size(); ++i) {
        nrrdNuke(vel_tsteps[i]);
    }

    backwards_vorticity_volume = spurt::lavd::create_nrrd_volume(vor_tsteps, outer_tmin, t_between_files);
    //Check for negative vorticities
    //size_t totalElements = current_vorticity_volume->axis[0].size * current_vorticity_volume->axis[1].size;
    //printf("totalElements: %ld\n", totalElements);
    //for (size_t idx = 0; idx < totalElements; ++idx) {
    //    value_t value = nrrd_value(current_vorticity_volume, idx);
    //    printf("%lf\n", value);
    //}
    //current_t_min = start_id*t_between_files;
    // if (outer_tmin > t_init) {
    //     current_t_min += support_radius*t_between_files;
    // }
    current_t_max = start_id * t_between_files;
    //if (current_t_max < t_max) current_t_max -= support_radius * t_between_files;
    //else current_t_max = t_max;
    _log_(1)
        << "n_used=" << n_used << '\n'
        << "support_radius=" << support_radius << '\n'
        << "current_t_max=" << current_t_max << '\n';

    _log_(1)
        << "selected region = " << region << '\n'
        << "x spacing: " << input_spc[0] << '\n'
        << "y spacing: " << input_spc[1] << std::endl;

    // compute average vorticity for selected region
    value_t* av_array = (value_t*)calloc(n_used, sizeof(value_t));
    value_t region_size = region.size()[0] * region.size()[1];
    _log_(1) << "sampling vorticity slices" << std::endl;

    size_t nx = vor_tsteps[0]->axis[0].size;
    size_t ny = vor_tsteps[0]->axis[1].size;
    value_t minx = domain.min()[0];
    value_t miny = domain.min()[1];
    value_t dx = input_spc[0];
    value_t dy = input_spc[1];

    _log_(1) << "nx=" << nx << ", ny=" << ny << '\n';
    _log_(1) << "minx=" << minx << ", mimy=" << miny << '\n';
    _log_(1) << "dx=" << dx << ", dy=" << dy << '\n';

    double min_offset_x = region.min()[0] - minx;
    double min_offset_y = region.min()[1] - miny;
    double max_offset_x = region.max()[0] - minx;
    double max_offset_y = region.max()[1] - miny;
    _log_(1) << "min offset x=" << min_offset_x << '\n';
    _log_(1) << "min offset y=" << min_offset_y << '\n';
    _log_(1) << "max offset x=" << max_offset_x << '\n';
    _log_(1) << "max offset y=" << max_offset_y << std::endl;

    size_t mini = min_offset_x <= 0 ? 0 : static_cast<size_t>(min_offset_x / dx);
    size_t minj = min_offset_y <= 0 ? 0 : static_cast<size_t>(min_offset_y / dy);
    size_t maxi = max_offset_x <= 0 ? 0 : std::min(static_cast<size_t>(max_offset_x / dx), nx - 1);
    size_t maxj = max_offset_y <= 0 ? 0 : std::min(static_cast<size_t>(max_offset_y / dy), ny - 1);

    if (mini >= nx || mini > maxi) _log_(1) << "invalid mini value: " << mini << std::endl;
    if (minj >= ny || minj > maxj) _log_(1) << "invalid minj value: " << minj << std::endl;
    if (maxi >= nx) _log_(1) << "invalid maxi value: " << maxi << std::endl;
    if (maxj >= ny) _log_(1) << "invalid maxj value: " << maxj << std::endl;
    size_t nsamples = (maxi - mini + 1) * (maxj - minj + 1);

    _log_(1)
        << "index range for selected region: ["
        << mini << ", " << maxi << "] x ["
        << minj << ", " << maxj << "]" << std::endl;

    spurt::ProgressDisplay progress(false);
    //progress.start(n_used * nsamples, "avg. vort.");
    //progress.set_active(true);
    size_t base_n = 0;
    size_t ncols = maxi - mini + 1;
    for (size_t n = 0; n < n_used; ++n, base_n += nsamples) {
        size_t nvalid_samples = 0;
        value_t sum = 0;
#pragma omp parallel
        {
#pragma omp for schedule(dynamic,1)
            for (size_t k = 0; k < nsamples; ++k) {
#if _OPENMP
                const int thread = omp_get_thread_num();
#else
                const int thread = 0;
#endif

                //if (!thread) progress.update(base_n + k);
                int j = k / ncols;
                int i = k % ncols;

                size_t id = (minj + j) * nx + (mini + i);

                if (nrrd_value(border_mask, id) != 0) {
                    value_t vort = nrrd_value(vor_tsteps[n], id);
#pragma omp atomic
                    sum += vort;
#pragma omp atomic
                    ++nvalid_samples;
                }
            }
        }
        av_array[n] = sum / static_cast<value_t>(nvalid_samples);
        _log_(1) << std::setprecision(12) << "average vorticity[" << n << "]=" << av_array[n] << std::endl;
        _log_(1) << "nsamples=" << nsamples << ", nvalid_samples=" << nvalid_samples << std::endl;
    }
    //progress.end();

    Nrrd* av = nrrdNew();
    if (nrrdWrap_nva(av, av_array, spurt::nrrd_utils::nrrd_value_traits_from_type<value_t>::index,
        1, &n_used)) {
        throw std::runtime_error(spurt::nrrd_utils::error_msg("unable to create 1D average vorticity nrrd"));
    }
    // Per-axis info
    int center = nrrdCenterNode;
    nrrdAxisInfoSet_nva(av, nrrdAxisInfoSpacing, &t_between_files);
    nrrdAxisInfoSet_nva(av, nrrdAxisInfoMin, &outer_tmin);
    nrrdAxisInfoSet_nva(av, nrrdAxisInfoCenter, &center);
    current_average_vorticity_vector = NrrdScalarField<1>::make3d(av);

    // clean up
    for (size_t i = 0; i < vor_tsteps.size(); ++i) {
        nrrdNuke(vor_tsteps[i]);
    }
    nrrdNuke(av);
}

void export_results(double current_time, double wall_time, double cpu_time, bool final) {

    std::ostringstream os;
    ios::fmtflags default_settings = os.flags();
    if (long_name) {
        os << name_out << "_started_at_" << start_time_str << "_flowmap+lavd_" << std::setw(5) << std::setfill('0') << current_time / spurt::lavd::HOUR << "h_";
        os << res[0] << "x" << res[1] << "_" << std::setprecision(2)
            << std::scientific << eps;
        os.flags(default_settings);
    }
    else {
        os << name_out << "_fmap+lavd_" << std::setw(5) << std::setfill('0') << current_time / spurt::lavd::HOUR << "h";
    }
    std::string basename = os.str();

    std::vector<std::string> comments;
    os.clear(); os.str("");
    os << "This file was produced by " << me
        << ". 1st axis corresponds to (flowmap_x, flowmap_y, lavd), where "
        << "lavd stands for Lagrangian averaged vorticity deviation.\n";
    comments.push_back(os.str()); os.clear(); os.str("");
    os << "Computation parameters:\n";
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * input file=" << name_in << '\n';
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * current time=" << current_time << "\n";
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * tmax=" << current_time << '\n';
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * epsilon=" << eps << '\n';
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * resolution=" << res[0] << "x" << res[1] << '\n';
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * bounds=" << region.min() << "->" << region.max() << '\n';
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * dt=" << dt << '\n';
    comments.push_back(os.str()); os.clear(); os.str("");
    os << " * kernel size=" << support_radius << '\n';
    comments.push_back(os.str());

    spurt::lavd::export_results< float >(
        current_time,
        wall_time, cpu_time,
        final,
        nb_lost,
        res[0], res[1],
        step_x, step_y,
        export_trajectories,
        region,
        basename,
        comments,
        all_trajectories,
        all_states
        );
}

void print_lavd_state(LAVD_state in) {
    printf("\tVorticity: %lf, %lf\n", in.m_vd, in.m_acc_vd);
    printf("\tTime: %lf, %lf\n", in.m_time, in.m_acc_time);
    printf("\tPos: %lf %lf\n", in.m_pos[0], in.m_pos[1]);
    printf("\tBirth: %lf %lf\n", in.birth_time, in.birth_value);
    printf("\tID: %d\n", in.unique_id);
}

void calculate_ground_truth(int count, value_t t0, size_t last_time_step, std::vector<std::string> velocity_filenames, std::vector<std::string> vorticity_filenames, value_t initial) {
    
    count = all_states.size();
    printf("Calculating ground truth for %d particles\n", count);

    using namespace spurt;
    using namespace odeint;

    bool initial_loop = true;

    value_t current_t_min = initial;
    while (t0 - ((nslices - 3) * 10800) > current_t_min) {
        current_t_min += ((nslices - 2) * 10800);
    }
    value_t current_start_time = t0;
    Nrrd* backwards_velocity_volume = current_velocity_volume;
    Nrrd* backwards_vorticity_volume = current_vorticity_volume;
    Nrrd* backwards_average_vorticity_vector = current_average_vorticity_vector;

    //printf("%p %p %p\n", backwards_velocity_volume, backwards_vorticity_volume, backwards_average_vorticity_vector);
    //printf("%d %d %d\n", backwards_velocity_volume->type, backwards_vorticity_volume->type, backwards_average_vorticity_vector->type);

    /*
    local_import(velocity_filenames, vorticity_filenames, std::max(0, (int)((t0 / HOUR / 3) - nslices + support_radius)), (t0 / HOUR / 3) + 2 * support_radius,
        backwards_velocity_volume,
        backwards_vorticity_volume,
        current_t_min,
        backwards_average_vorticity_vector,
        last_time_step);
    */
    //last_time_step = (current_t_min / HOUR / 3) - nslices + support_radius; //INCORRECT
    if (last_time_step < 0) last_time_step = 0;

    std::vector<size_t> sample_counter(nb_threads);
    std::vector< shared_ptr< NrrdODERHS > > rhs_copies(nb_threads);
    std::vector< shared_ptr< NrrdVectorField > > vf_copies(nb_threads);
    for (int i = 0; i < nb_threads; ++i) {
        vf_copies[i] = shared_ptr< NrrdVectorField >(new NrrdVectorField(backwards_velocity_volume, std::string("velocity volume for thread #") + std::to_string(i), false));
        rhs_copies[i] = shared_ptr< NrrdODERHS >(new NrrdODERHS(*vf_copies[i], sample_counter[i], domain, max_rhs_evals));
    }

    spurt::ProgressDisplay progress(false);

    std::vector<vec2> pos;
    std::vector<vec2> lavd;
    for (int i = 0; i < count; i++) {
        pos.push_back(all_trajectories[all_states.size() - (1 + i)].back());
        vec2 x;
        x[0] = all_states[all_states.size() - (1 + i)].m_vd;
        x[1] = all_states[all_states.size() - (1 + i)].m_acc_vd;
        lavd.push_back(x);
    }
    //std::reverse(lavd.begin(), lavd.end());

    progress.start(count * (t0 / 10800), "backwards integration");
    progress.set_active(true);
    int iterations = 0;

    //printf("current_t_min: %lf\n", current_t_min);

    while (true) {
        value_t current_target_time = std::max((int)current_t_min, 0);
        current_target_time = std::max(current_target_time, current_start_time - t_export_step);
        if (current_start_time == 0) break;


        //printf("Current start time: %lf\n", current_start_time);
        //printf("Current target time: %lf\n", current_target_time);

        //printf("Backwards integrating from %.0lf seconds to %.0lf seconds at intervals of %.0lf seconds\n", current_start_time, current_target_time, -dt);
        #pragma omp parallel
        {
            #pragma omp for schedule(dynamic,1)
            for (int i = 0; i < count; i++) {
                #if _OPENMP
                const int thread = omp_get_thread_num();
                #else
                const int thread = 0;
                #endif

                if (!thread) progress.update(i + (count * iterations));

                LAVD_state& curr_state = all_states[all_states.size() - (1 + i)];
                std::vector<vec2>& curr_trajectory = all_trajectories[all_states.size() - (1 + i)];
                vec2 x0 = curr_trajectory.back();
                //vec2 x1 = x0;
                auto stepper = make_controlled(eps, eps, runge_kutta_dopri5<vec2>());
                NrrdODERHS& rhs = *rhs_copies[thread];
                rhs.m_counter = 0;

                NrrdScalarField<1> my_avg_vorticityf(backwards_average_vorticity_vector, std::string("average vorticity field for thread #") + std::to_string(thread));
                NrrdScalarField<3> my_vorticityf(backwards_vorticity_volume, std::string("vorticity field for thread #" + std::to_string(thread)));

                if (initial_loop) {
                    //if (all_states.size() - (1 + i) == 500000) {
                    //    print_lavd_state(curr_state);
                    //}
                    //curr_state.m_vd = 0;
                    //curr_state.m_acc_vd = 0;
                    //curr_state.m_time = 0;
                    //curr_state.m_acc_time = 0;
                }
                observer an_observer(curr_state, curr_trajectory, my_vorticityf, my_avg_vorticityf);

                try {
                    //if (all_states.size() - (1 + i) == 500000) {
                        //print_lavd_state(curr_state);
                    //}
                    integrate_const(stepper, rhs, x0, current_start_time,
                        current_target_time, -dt, an_observer);
                    //if (all_states.size() - (1 + i) == 500000) {
                        //print_lavd_state(curr_state);
                    //}
                }
                catch (std::exception& e) {
                    _log_(1) << "caught exception while integrating from "
                        << x0 << ":" << e.what() << '\n'
                        << "integration started at " << x0
                        << " and ended at " << curr_trajectory.back()
                        << '\n' << std::flush;
                }
            }
        }
        //printf("Finished integration\n");
        iterations++;

        initial_loop = false;

        if (current_target_time == 0) break;
        if (current_target_time == current_t_min) {
            // we have reached the end of the data currently available in
            // RAM. Import next time section.
            // [last_time_step-2*R, last_time_step-2*R+nslices-1]
            //printf("Importing file(s) set: %ld\n", last_time_step - 2 * support_radius);
            if (backwards_velocity_volume != current_velocity_volume) {
                nrrdNuke(backwards_velocity_volume);
                nrrdNuke(backwards_vorticity_volume);
                nrrdNuke(backwards_average_vorticity_vector);
            }

            //printf("Last time step before update: %ld\n", last_time_step);
            //printf("Current_t_min before update: %lf\n", current_t_min);
            last_time_step = current_t_min / 10800;
            last_time_step -= nslices - 4;
            local_import(velocity_filenames, vorticity_filenames,
                last_time_step/* - 2 * support_radius*/, (t0 / HOUR / 3) + 2 * support_radius,
                backwards_velocity_volume,
                backwards_vorticity_volume,
                current_t_min,
                backwards_average_vorticity_vector,
                last_time_step);
            //last_time_step = (current_t_min / HOUR / 3) - nslices + support_radius;
            //current_t_min -= ((nslices - 2) * 10800);
            //if (current_t_min < 0) current_t_min = 0;
            //printf("Last time step after update: %ld\n", last_time_step);
            //printf("Current_t_min after update: %lf\n", current_t_min);
            for (int i = 0; i < nb_threads; ++i) {
                vf_copies[i] = shared_ptr< NrrdVectorField >(new NrrdVectorField(backwards_velocity_volume, std::string("velocity volume for thread #") + std::to_string(i), false));
                rhs_copies[i] = shared_ptr< NrrdODERHS >(new NrrdODERHS(*vf_copies[i], sample_counter[i], domain, max_rhs_evals));
            }
        }

        current_start_time = current_target_time;
    }
    progress.end();

    //print_lavd_state(all_states[468991]);

    for (int i = 0; i < count; i++) {
        LAVD_state& curr_state = all_states[all_states.size() - (1 + i)];
        curr_state.m_vd = lavd[i][0];
        //if (all_states.size() - (1 + i) == 500000) {
        //    printf("%lf - %lf\n", curr_state.m_vd, lavd[i][0]);
        //}
        //curr_state.m_vd -= lavd[i][0];
        //printf("%lf\n", curr_state.m_acc_vd);
        curr_state.m_acc_vd -= lavd[i][1];
        //curr_state.m_vd *= -1;
        curr_state.m_acc_vd *= -1;
        all_trajectories[all_states.size() - (1 + i)].back() = pos[i];
        curr_state.m_pos = pos[i];
        curr_state.m_time = t0;
        curr_state.m_acc_time = t0;
    }

    if (backwards_velocity_volume != current_velocity_volume) {
        nrrdNuke(backwards_velocity_volume);
        nrrdNuke(backwards_vorticity_volume);
        nrrdNuke(backwards_average_vorticity_vector);
    }
}

void backwards_verification(const std::vector< std::string >& velocity_filenames, const std::vector< std::string >& vorticity_filenames, value_t current_start_time) {
    using namespace spurt;
    using namespace odeint;

    //import_data(velocity_filenames, vorticity_filenames, 951);
    //printf("Before integration: %lf\n", all_states[500000].m_acc_vd);

    //print_lavd_state(all_states[1050000]);
    //print_lavd_state(all_states[500000]);

    //std::vector<double> original_values;
    //for (int i = 0; i < all_states.size(); i++) {
    //    original_values.push_back(all_states[i].m_acc_vd);
    //}

    std::vector<size_t> sample_counter(nb_threads);
    std::vector< shared_ptr< NrrdODERHS > > rhs_copies(nb_threads);
    std::vector< shared_ptr< NrrdVectorField > > vf_copies(nb_threads);
    for (int i = 0; i < nb_threads; ++i) {
        vf_copies[i] = shared_ptr< NrrdVectorField >(new NrrdVectorField(current_velocity_volume, std::string("velocity volume for thread #") + std::to_string(i), false));
        rhs_copies[i] = shared_ptr< NrrdODERHS >(new NrrdODERHS(*vf_copies[i], sample_counter[i], domain, max_rhs_evals));
    }
    printf("Current_t_min: %lf\n", current_t_min);
    printf("Current start time: %lf\n", current_start_time);

    value_t current_target_time = current_start_time;
    while (true) {
        current_target_time -= t_export_step;
        //print_lavd_state(all_states[280000]);

        printf("Integrating from %.0lf seconds to %.0lf seconds at intervals of %.0lf seconds\n", current_start_time, current_target_time, -dt);
        #pragma omp parallel
        {
            #pragma omp for schedule(dynamic,1)
            for (int i = 0; i < all_states.size(); i++) {
                #if _OPENMP
                const int thread = omp_get_thread_num();
                #else
                const int thread = 0;
                #endif

                //if (!thread) progress.update(i + (count * iterations));

                LAVD_state& curr_state = all_states[i];
                if (curr_state.m_stopped) {
                    continue;
                }
                if (curr_state.birth_time < current_start_time) {
                    continue;                                                             //Integrate only when needed
                }

                std::vector<vec2>& curr_trajectory = all_trajectories[i];
                vec2 x0 = curr_trajectory.back();
                //vec2 x1 = x0;
                auto stepper = make_controlled(eps, eps, runge_kutta_dopri5<vec2>());
                NrrdODERHS& rhs = *rhs_copies[thread];
                rhs.m_counter = 0;

                NrrdScalarField<1> my_avg_vorticityf(current_average_vorticity_vector, std::string("average vorticity field for thread #") + std::to_string(thread));
                NrrdScalarField<3> my_vorticityf(current_vorticity_volume, std::string("vorticity field for thread #" + std::to_string(thread)));

                //if (initial_loop) {
                    //if (all_states.size() - (1 + i) == 500000) {
                    //    print_lavd_state(curr_state);
                    //}
                    //curr_state.m_vd = 0;
                    //curr_state.m_acc_vd = 0;
                    //curr_state.m_time = 0;
                    //curr_state.m_acc_time = 0;
                //}
                observer an_observer(curr_state, curr_trajectory, my_vorticityf, my_avg_vorticityf);

                try {
                    //if (all_states.size() - (1 + i) == 500000) {
                        //print_lavd_state(curr_state);
                    //}
                    integrate_const(stepper, rhs, x0, current_start_time,
                        current_target_time, -dt, an_observer);
                    //if (all_states.size() - (1 + i) == 500000) {
                        //print_lavd_state(curr_state);
                    //}
                }
                catch (std::exception& e) {
                    _log_(1) << "caught exception while integrating from "
                        << x0 << ":" << e.what() << '\n'
                        << "integration started at " << x0
                        << " and ended at " << curr_trajectory.back()
                        << '\n' << std::flush;
                    curr_state.m_stopped = true;
                }
            }
        }
        //print_lavd_state(all_states[1050000]);

        if (current_target_time <= 0) break;
        if (current_target_time == current_t_min) {
            current_t_min -= (nslices - 7) * t_export_step;
            current_t_min < 0 ? current_t_min = 0 : 0;
            printf("Current_t_min: %lf\n", current_t_min);
            import_data(velocity_filenames, vorticity_filenames, current_t_min / t_export_step);
            for (int i = 0; i < nb_threads; ++i) {
                vf_copies[i] = shared_ptr< NrrdVectorField >(new NrrdVectorField(current_velocity_volume, std::string("velocity volume for thread #") + std::to_string(i), false));
                rhs_copies[i] = shared_ptr< NrrdODERHS >(new NrrdODERHS(*vf_copies[i], sample_counter[i], domain, max_rhs_evals));
            }
            //Periodically export results
            export_results(current_target_time, (value_t)(1), (value_t)(1), false);
        }
        current_start_time = current_target_time;
        //export_results(current_start_time, (value_t)(1), (value_t)(1), false);
    }
    export_results((value_t)(0), (value_t)(1), (value_t)(1), true);
    //printf("After integration: %lf\n", all_states[500000].m_acc_vd);
    //print_lavd_state(all_states[468991]);
    //print_lavd_state(all_states[1050000]);
    //print_lavd_state(all_states[500000]);
    //print_lavd_state(all_states[280000]);
}

//fabs
LAVD_state lavd_state_lerp(LAVD_state a, LAVD_state b, LAVD_state c, Point center, value_t time) {
    LAVD_state new_state = {};
    //new_state.m_vd = 0;
    //new_state.m_acc_vd = 0;
    //new_state.m_time = 0;
    //new_state.m_acc_time = 0;
    new_state.m_vd = (a.m_vd + b.m_vd + c.m_vd) / 3;
    new_state.m_acc_vd = (a.m_acc_vd + b.m_acc_vd + c.m_acc_vd) / 3;
    new_state.m_time = (a.m_time + b.m_time + c.m_time) / 3;
    new_state.m_acc_time = (a.m_acc_time + b.m_acc_time + c.m_acc_time) / 3;
    new_state.m_pos[0] = center.x();
    new_state.m_pos[1] = center.y();
    new_state.m_stopped = false;

    new_state.meta_lifetime = 0;

    new_state.birth_time = time;
    new_state.birth_value = new_state.m_acc_vd;
#pragma omp critical
    new_state.unique_id = global_identifier++;

    return new_state;
}

int add_border_states(value_t time, NrrdScalarField<1>* avg_vorticityf, NrrdScalarField<3>* vorticityf, std::vector<LAVD_state>* current_states) {
    int added = 0;
    step_x = region.size()[0] / static_cast<value_t>(res[0] - 1);
    step_y = region.size()[1] / static_cast<value_t>(res[1] - 1);
    //printf("%lf %lf\n", step_x, step_y);
    //printf("%lf %lf\n", region.size()[0], region.size()[1]);
    //printf("%lf %lf\n", static_cast<value_t>(res[0] - 1), static_cast<value_t>(res[1] - 1));
    int i = 0;
    //Calculate border positions
    std::vector<vec2> positions = {};
    //printf("%lf, %lf\n", step_x, step_y);
    for (i = 1; i < res[0] - 1; i++) {
        positions.push_back(region.min() + vec2(i * step_x, 1 * step_y));
        positions.push_back(region.min() + vec2(i * step_x, region.max()[1] - region.min()[1] - step_y));
        added += 2;
    }
    for (i = 1; i < res[1] - 1; i++) {
        positions.push_back(region.min() + vec2(1 * step_x, i * step_y));
        positions.push_back(region.min() + vec2(region.max()[0] - region.min()[0] - step_x, i * step_y));
        added += 2;
    }

    //Find relevant states
    std::vector<LAVD_state> states;
    for (LAVD_state state : *current_states) {
        if ((abs(state.m_pos[0] - region.min()[0]) < step_x ||
            abs(state.m_pos[1] - region.min()[1]) < step_y ||
            abs(state.m_pos[0] - region.max()[0]) < step_x ||
            abs(state.m_pos[1] - region.max()[1]) < step_y)){
                states.push_back(state);
            }
    }
    //printf("Number of border-relevant points: %ld\n", states.size());
    //printf("%lf, %lf\n", (*current_states)[i].m_pos[0], region.min()[0]);

    //Generate states from positions
    for (i = 0; i < positions.size(); i++) {
        //printf("%d: %lf %lf\n", i, positions[i][0], positions[i][1]);
        std::vector<vec2> new_trajectory = {};
        new_trajectory.push_back(positions[i]);
        all_trajectories.push_back(new_trajectory);
        LAVD_state new_state = {};
        new_state.m_pos = positions[i];
        new_state.m_time = time;
        new_state.m_acc_time = time;
        new_state.m_stopped = false;

        value_t w = (*vorticityf)(vec3(positions[i][0], positions[i][1], time));
        value_t aw = (*avg_vorticityf)(vec1(time));
        //new_state.m_vd = 0;
        //new_state.m_vd = fabs(w - aw);
        new_state.m_vd = w - aw;

        if (w == 0.0) {
            added--;
            continue;
        }

        bool keep = true;
        for (LAVD_state state : states) {
            if (((state.m_pos[0] - new_state.m_pos[0]) * (state.m_pos[0] - new_state.m_pos[0])) + ((state.m_pos[1] - new_state.m_pos[1]) * (state.m_pos[1] - new_state.m_pos[1])) < step_x) {
                //Too close to another point
                keep = false;
                added--;
                break;
            }
        }
        if (keep) {

            new_state.m_acc_vd = new_state.m_vd;

            new_state.birth_time = time;
            new_state.birth_value = new_state.m_acc_vd;
#pragma omp critical
            new_state.unique_id = global_identifier++;

            all_states.push_back(new_state);
        }
    }
    return added;
}

int main(int argc, const char* argv[])
{
    using namespace spurt;
    using namespace odeint;

    me=argv[0];

    nb_threads=1;

#if _OPENMP
    nb_threads = omp_get_max_threads();
    _log_.set_nthreads(nb_threads);
    _log_(1) << nb_threads << " threads available" << std::endl;
    printf("Using %ld threads from OpenMP\n", nb_threads);
#else
    _log_.set_nthreads(1);
#endif

    initialize(argc, argv);

    log_file.open(log_name.c_str());
    _log_.set_thresholds(verbose_cout, verbose_log);

    if (t_max < 0) {
        _log_(0) << "Invalid time duration symbol in definition of tmax" << std::endl;
        clean_exit(1);
    }

    if (dt < 0) {
        dt = (t_max - t_init)/(fabs(dt)-1);
    }

    if (nb_samples == 0) {
        nb_samples = res[0] * res[1];
    }

    name_out=spurt::filename::remove_extension(name_out);

    std::vector<std::string> velocity_filenames;
    std::vector<std::string> vorticity_filenames;

    std::fstream info_file(name_in, std::ios::in);
    if (!info_file) {
        _log_(0) << "Unable to open info file named " << name_in << std::endl;
        exit(1);
    }

    boost::filesystem::path p(name_in);
    std::string parent_dir=p.parent_path().string();
    while (info_file.good()) {
        std::string velname, vortname;
        value_t avg;
        info_file >> velname >> vortname >> avg;
        if (velname[0] == '\0') continue;
        velocity_filenames.push_back(parent_dir + '/' + velname);
        vorticity_filenames.push_back(parent_dir + '/' + vortname);
    }
    info_file.close();
    assert(!velocity_filenames.empty());

    _log_(1) << velocity_filenames.size() << " time steps in input" << std::endl;

    // compute bounds of entire domain
    get_spatial_info(domain, input_spc, velocity_filenames[t_init/HOUR/3], 1);
    border_mask = get_border_mask(border_mask_name, velocity_filenames[t_init/HOUR/3]);
    //printf("Border mask: %s\n", border_mask_name.c_str());

    if ( !( bnds[0]==bnds[1]==bnds[2]==bnds[3] ) ) {
        region.min()=vec2( bnds[0], bnds[1] );
        region.max()=vec2( bnds[2], bnds[3] );
    }
    else {
        region.min() = domain.min();
        region.max() = domain.max();
    }

    _log_(1) << "region=\n" << region << std::endl;

    // storage for LAVD states and trajectories
    all_trajectories.resize(nb_samples);
    all_states.resize(nb_samples);

    //printf("Initializing IDs for %ld particles\n", nb_samples);
    //for (int i = 0; i < nb_samples; i++) {
    //    all_states[i].unique_id = global_identifier++;
    //}

	// if restarting from last output, initialize these arrays with available information

	std::vector<double> restart_values;
	if (!restart_name.empty()) {
		Nrrd* nin = spurt::nrrd_utils::readNrrd(restart_name);
		spurt::nrrd_utils::to_vector(restart_values, nin);
		for (size_t i=0; i<all_trajectories.size(); ++i) {
			all_trajectories[i].push_back(nvis::vec2(restart_values[3*i], restart_values[3*i+1]));
		}
	}
    std::vector<int> restart_values2;
    if (!restart_name.empty()) {
        std::string file_name;
        file_name = restart_name;
        file_name.insert(file_name.size() - 5, "2");
        //printf("%s\n", file_name.c_str());
        Nrrd* nin = spurt::nrrd_utils::readNrrd(file_name);
        spurt::nrrd_utils::to_vector(restart_values2, nin);
    }

    support_radius = spurt::lavd::compute_support_radius();
    _log_(1) << "support radius = " << support_radius << std::endl;

    // initialize velocity and vorticity volumes
    //printf("Importing file(s) set: %ld\n", (long)(t_init / HOUR / 3));
    import_data(velocity_filenames, vorticity_filenames, t_init/HOUR/3 < 0 ? 0 : t_init / HOUR / 3);

    size_t counter = 0;
    size_t nb_early = 0;

    step_x = region.size()[0] / static_cast<value_t>(res[0]-1);
    step_y = region.size()[1] / static_cast<value_t>(res[1]-1);

    printf("step_x: %lf; step_y: %lf\n", step_x, step_y);

    _log_(1) << "bounds=" << region << std::endl;

    if (export_region)
        spurt::lavd::export_mask(vorticity_filenames[t_init/HOUR/3], region, true);

    std::vector<size_t> sample_counter(nb_threads);
    std::vector< shared_ptr< NrrdODERHS > > rhs_copies(nb_threads);
    std::vector< shared_ptr< NrrdVectorField > > vf_copies(nb_threads);
    for (int i=0; i<nb_threads; ++i) {
        vf_copies[i] = shared_ptr< NrrdVectorField >(new NrrdVectorField(current_velocity_volume, std::string("velocity volume for thread #") + std::to_string(i), false));
        rhs_copies[i] = shared_ptr< NrrdODERHS >(new NrrdODERHS(*vf_copies[i], sample_counter[i], domain, max_rhs_evals));
    }

    start_time_str=sec2time(t_init);
    std::for_each(start_time_str.begin(), start_time_str.end(),
                 [](char& c) { if (c==' ') c='_'; });
    _log_(1) << "start_time_string=" << start_time_str << std::endl;

    spurt::ProgressDisplay progress(false), total_progress(false);

    total_progress.start(1); // we only care for the timer function
    total_progress.set_active(false);

    std::clock_t clock_begin=std::clock();
    auto timer_start = std::chrono::high_resolution_clock::now();

    bool initial_loop = true;
    size_t niter = 0;
    current_start_time = t_init;
    current_t_min = t_init;
    next_export_time = t_init + t_export_step + t_skip;
    //std::vector< LAVD_state > memory;
    int moving_index = -1;
    double distance = 0.0;
    while ( true ) {
        //printf("A!\n");
        _log_(0, "\n\n") << "next target time for this loop: "
            << sec2time(next_export_time)
            << " (" << next_export_time << " s.)" << std::endl;

        progress.start(nb_samples, "flow map");
        progress.set_active(true);
        counter = 0;
        nb_lost = 0;
        size_t nb_early = 0;
        value_t current_target_time = std::min(current_t_max, next_export_time);
        if (current_start_time == current_target_time) break;

        std::clock_t loop_clock_begin=std::clock();
        auto loop_timer_start = std::chrono::high_resolution_clock::now();

        printf("Integrating from %.0lf seconds to %.0lf seconds at intervals of %.0lf seconds\n", current_start_time, current_target_time, dt);
        printf("current_t_min: %lf\n t_init: %lf current_t_max: %lf\n", current_t_min, t_init, current_t_max);
        //printf("Global ID set at: %d\n", global_identifier);
        //printf("Global array len: %ld\n", all_states.size());
        #pragma omp barrier
        //printf("State 0/%ld position: %lf %lf\n", all_states.size(), all_states[0].m_pos[0], all_states[0].m_pos[1]);
        //for(int i = 0; i < nb_samples/100; i++)
        //printf("State %d: %lf %lf %lf %lf %lf %lf %d\n", i*100, all_states[i*100].m_vd, all_states[i*100].m_acc_vd, all_states[i*100].m_time, all_states[i*100].m_acc_time, all_states[i*100].m_pos[0], all_states[i*100].m_pos[1], all_states[i*100].m_stopped);

        // ------------------------------------------------------------------------------------------------------------------------------------------------------------------
        #pragma omp parallel
        {
            //Iterate over every "pixel"
            #pragma omp for schedule(dynamic,1)
            for (size_t n = 0 ; n < nb_samples ; ++n) {

                #if _OPENMP
                const int thread=omp_get_thread_num();
                #else
                const int thread=0;
                #endif

                if (!thread) progress.update(n);

                if (all_states[n].m_stopped) {
                    #pragma omp atomic
                    ++nb_lost;
                    continue;
                }

                vec2 x0;
                if (initial_loop && restart_name.empty()) {
                    size_t i = n % res[0];
                    size_t j = n / res[0];
                    x0 = region.min() + vec2(i*step_x, j*step_y);
                    _log_(2) << "\n\n\n\nstarting integration #" << n << " at " << x0 << std::endl;
                }
                else {
                    x0 = all_trajectories[n].back();
                    if (x0[0] == 279.75) x0[0] -= 0.000001;
					if (initial_loop && !restart_name.empty()) {
						_log_(2) << "\n\n\n\nresuming integration #" << n << " at " << x0 << std::endl;
					}
                }

                /*if (n == 125) { //When res = 16
                    printf("%ld, %lf %lf\n", n, x0[0], x0[1]);
                    if (abs(x0[0] - (region.min()[0] + n % res[0] * step_x)) > distance) {
                        distance = abs(x0[0] - (region.min()[0] + n % res[0] * step_x));
                        moving_index = n;
                    }
                    printf("%d, %lf\n", moving_index, distance);
                }*/
                //_log_(1) << x0 << std::endl;

                #pragma omp atomic
                ++counter;

                // create a stepper
                auto stepper = make_controlled(eps, eps, runge_kutta_dopri5<vec2>());

                NrrdODERHS& rhs=*rhs_copies[thread];
                rhs.m_counter=0;

                NrrdScalarField<1> my_avg_vorticityf(current_average_vorticity_vector, std::string("average vorticity field for thread #") + std::to_string(thread));
                NrrdScalarField<3> my_vorticityf(current_vorticity_volume, std::string("vorticity field for thread #" + std::to_string(thread)));
                //Search the vorticity field
                //NrrdScalarField<3>::pos_t position = { x0[0], x0[1], 0 };
                //try {
                //    value_t value = my_vorticityf(position);
                //    printf("%lf\n", value);
                //}
                //catch (const std::exception& e) {
                //
                //}
                observer an_observer(all_states[n], all_trajectories[n],
                                     my_vorticityf, my_avg_vorticityf);

                //if (n == 500000) {
                //    print_lavd_state(all_states[n]);
                //}

                if (initial_loop) {
                    _log_(2) << "initializing observer at " << x0 << std::endl;
                    try {
                        #pragma omp critical
                        an_observer.initialize(x0, current_t_min);
						if (!restart_name.empty()) {
							all_states[n].m_acc_vd = restart_values[3*n+2];
                            all_states[n].meta_lifetime = restart_values2[3*n];
                            all_states[n].unique_id = restart_values2[3*n+1];
                            all_states[n].birth_time = restart_values2[3*n+2];
                            #pragma omp critical
                            {
                                if (all_states[n].unique_id >= global_identifier) {
                                    global_identifier = all_states[n].unique_id + 1;
                                }
                            }

                            //if (all_states[n].m_acc_vd > -350 || all_states[n].m_acc_vd < -450) {
                            //    all_states[n].meta_lifetime = 0;
                            //}
                            //else {
                            //    all_states[n].meta_lifetime = 10000;
                            //}
						}
                    }
                    catch( std::exception& e ) {
                        _log_(1) << "caught exception while attempting "
                            << "to initialize observer at " << x0 << std::endl;
                        all_states[n].stop();
                        if (restart_name.empty()) all_trajectories[n].push_back(x0); // otherwise trajectory already contains seed point
                        #pragma omp atommic
                        ++nb_lost;
                        continue;
                    }
                }
                
                try {
                    //if (n == 500000) {
                        //printf("%lf %lf, %lf - %lf\n", x0[0], x0[1], current_start_time, current_target_time);
                        //print_lavd_state(all_states[n]);
                    //}
                    integrate_const(stepper, rhs, x0, current_start_time,
                        current_target_time, dt, an_observer);
                    //if (n == 500000) {
                        //printf("%lf %lf, %lf - %lf\n", x0[0], x0[1], current_start_time, current_target_time);
                        //print_lavd_state(all_states[n]);
                    //}
                }
                catch(std::exception& e) {
                    _log_(1) << "caught exception while integrating from "
                            << x0 << ":" << e.what() << '\n'
                            << "integration started at " << x0
                            << " and ended at " << all_trajectories[n].back()
                            << '\n' << std::flush;
                    all_states[n].stop();
                    #pragma omp atomic
                    ++nb_lost;
                    //A particle has left the area (presumably)
                    //printf("%ld\n", n);
                }
                catch(...) {
                    _log_(0) << "unknown exception thrown!" << std::endl;
                }
                _log_(2) << rhs.m_counter << " RHS evaluations for this IC"
                    << std::endl;
            }

            initial_loop = false;
        }
        #pragma omp barrier
	    progress.end();
        // ------------------------------------------------------------------------------------------------------------------------------------------------------------------
        //printf("Global ID set at: %d\n", global_identifier);
        //printf("Global array len: %ld\n", all_states.size());

        printf("Adding streamlines...\n");
        value_t res_distance = step_x;
        std::vector<Delaunay::Finite_faces_iterator> triangles;
        std::vector<Point> points = {};
        std::map<Point, size_t> point_map = {};
        for (int i = 0; i < nb_samples; i++) {
            if (all_states[i].m_stopped) continue;
            //Check if the point already exists in the map
            if (point_map.count(Point(all_states[i].m_pos[0], all_states[i].m_pos[1])) != 0) continue;          //Checking for duplicate points!!!
            points.push_back(Point(all_states[i].m_pos[0], all_states[i].m_pos[1]));
            point_map.insert({ Point(all_states[i].m_pos[0], all_states[i].m_pos[1]), i });

            all_states[i].m_stopped = true;
        }

        //Use Delaunay triangulation to find voids in the visualization
        printf("Performing Delaunay triangulation...\n");
        Delaunay dt;
        dt.insert(points.begin(), points.end());
        //printf("Sorting results...\n");
        //FILL HOLES
        for (auto f = dt.finite_faces_begin(); f != dt.finite_faces_end(); f++) {
            Point a = f->vertex(0)->point();
            Point b = f->vertex(1)->point();
            Point c = f->vertex(2)->point();
            all_states[point_map[a]].m_stopped = false;
            all_states[point_map[b]].m_stopped = false;
            all_states[point_map[c]].m_stopped = false;

            Point circumcenter = CGAL::circumcenter(a, b, c);
            double dist = sqrt(CGAL::squared_distance(a, circumcenter)) * 2;
            if (dist > res_distance * 2) {
                triangles.push_back(f);
            }
        }
        printf("Found %ld candidate seeds\n", triangles.size());
        //Use the voids to seed streamlines
        std::vector<Point> added = {};
        size_t old_sample_count = nb_samples;
        printf("Filling voids...\n");
        for(int i = 0; i < triangles.size(); i++) {
            //printf("%ld\n", triangles.size());
            Delaunay::Finite_faces_iterator face = triangles[i];
            Point a = face->vertex(0)->point();
            Point b = face->vertex(1)->point();
            Point c = face->vertex(2)->point();
            Point circumcenter = CGAL::circumcenter(a, b, c);
            //Verify circumcenter is within bounds
            if (circumcenter.x() < region.min()[0] || circumcenter.y() < region.min()[1] || 
                circumcenter.x() > region.max()[0] || circumcenter.y() > region.max()[1]) {
                //printf("INVALID COORDINATE: %lf %lf\n", circumcenter.x(), circumcenter.y());
                continue;
            }
            //Add point
            LAVD_state one = all_states[point_map[a]];
            LAVD_state two = all_states[point_map[b]];
            LAVD_state three = all_states[point_map[c]];
            //Lerp to create new lavd state
            LAVD_state new_point = lavd_state_lerp(one, two, three, circumcenter, current_target_time);
            all_states.push_back(new_point);
            std::vector<vec2> new_trajectory = {};
            vec2 new_vector = new_point.m_pos;
            new_trajectory.push_back(new_vector);
            all_trajectories.push_back(new_trajectory);
            nb_samples++;
        }
        printf("Added %ld streamlines in sparse areas\n", nb_samples - old_sample_count);
        triangles.clear();

        //Ground truth
        //printf("Before ground truth: %lf (%lf %lf)\n", all_states.back().m_acc_vd, all_trajectories.back().back()[0], all_trajectories.back().back()[1]);
        //printf("%lf (%lf %lf)\n", all_states[500000].m_acc_vd, all_trajectories[500000].back()[0], all_trajectories[500000].back()[1]);
        //print_lavd_state(all_states[468991]);
        for (int i = 0; i < all_states.size(); i++) {
            if (all_states[i].unique_id == 1050000 || all_states[i].unique_id == 500000)
                //print_lavd_state(all_states[i]);
                ;
        }
        //print_lavd_state(all_states[500000]);
        //if(current_target_time >= 3600*48)
        //calculate_ground_truth(nb_samples - old_sample_count, current_target_time, import_start, velocity_filenames, vorticity_filenames, current_t_min);
        //printf("After ground truth: %lf (%lf %lf)\n", all_states.back().m_acc_vd, all_trajectories.back().back()[0], all_trajectories.back().back()[1]);
        //printf("%lf (%lf %lf)\n", all_states[500000].m_acc_vd, all_trajectories[500000].back()[0], all_trajectories[500000].back()[1]);
        //print_lavd_state(all_states[500000]);
        //print_lavd_state(all_states[468991]);

        /*
        //Remove streamlines that are too dense
        for (auto f = dt.finite_faces_begin(); f != dt.finite_faces_end(); f++) {
            Point a = f->vertex(0)->point();
            Point b = f->vertex(1)->point();
            Point c = f->vertex(2)->point();
            Point circumcenter = CGAL::circumcenter(a, b, c);
            double dist = sqrt(CGAL::squared_distance(a, circumcenter)) * 2;
            if (dist < res_distance / 2) {

                //Longest lifespan
                int l0 = all_states[point_map[f->vertex(0)->point()]].meta_lifetime;
                int l1 = all_states[point_map[f->vertex(1)->point()]].meta_lifetime;
                int l2 = all_states[point_map[f->vertex(2)->point()]].meta_lifetime;
                auto representative = f->vertex(0);
                if (l1 > l0) {
                    representative = f->vertex(1);
                }
                if (l2 > l1 && l2 > l0) {
                    representative = f->vertex(2);
                }

                //Kill neighbors
                if (all_states[point_map[representative->point()]].m_stopped == true) {
                    continue;
                }
                Delaunay::Vertex_circulator vc = dt.incident_vertices(representative);
                if (vc != nullptr) {
                    Delaunay::Vertex_circulator start = vc;
                    do {
                        if (!dt.is_infinite(vc)) {
                            if (sqrt(CGAL::squared_distance(vc->point(), representative->point()) < res_distance / 2)) {
                                all_states[point_map[vc->point()]].m_stopped = true;
                            }
                        }
                    } while (++vc != start);
                }
            }            
        }
        */
        
        
        /*
        old_sample_count = nb_samples;
        for (int i = 0; i < triangles.size(); i++) {
            Delaunay::Finite_faces_iterator face = triangles[i];
            Point a = face->vertex(0)->point();
            Point b = face->vertex(1)->point();
            Point c = face->vertex(2)->point();
            Point circumcenter = CGAL::circumcenter(a, b, c);
            //Add point
            LAVD_state one = all_states[point_map[a]];
            LAVD_state two = all_states[point_map[b]];
            LAVD_state three = all_states[point_map[c]];
            //Lerp to create new lavd state
            LAVD_state new_point = lavd_state_lerp(one, two, three, circumcenter, current_target_time);
            all_states.push_back(new_point);
            std::vector<vec2> new_trajectory = {};
            vec2 new_vector = new_point.m_pos;
            new_trajectory.push_back(new_vector);
            all_trajectories.push_back(new_trajectory);
            nb_samples++;
            all_states[point_map[a]].m_stopped = true;
            all_states[point_map[b]].m_stopped = true;
            all_states[point_map[c]].m_stopped = true;
        }
        */
        //printf("Added %ld streamlines in dense areas\n", nb_samples - old_sample_count);

        NrrdScalarField<1> my_avg_vorticityf(current_average_vorticity_vector, std::string("average vorticity field"));
        NrrdScalarField<3> my_vorticityf(current_vorticity_volume, std::string("vorticity field"));
        //printf("VV size: %ld %ld %ld\n", current_vorticity_volume->axis[0].size, current_vorticity_volume->axis[1].size, current_vorticity_volume->axis[2].size);
        old_sample_count = nb_samples;
        //runtime error when restarting
        nb_samples += add_border_states(current_target_time, &my_avg_vorticityf, &my_vorticityf, &all_states);
        printf("Added %ld streamlines around the border\n", nb_samples - old_sample_count);

        //Clean up dead points
        if (current_target_time == next_export_time) {
            std::vector< std::vector< vec2 > > real_trajectories;
            std::vector< LAVD_state > real_states;
            for (int i = 0; i < nb_samples; i++) {
                if (all_states[i].m_stopped == false) {
                    //Also remove duplicate points
                    //bool duplicate = false;
                    //for (int j = 0; j < real_states.size(); j++) {
                    //    nvis::fixed_vector<bool, 2> comp = all_trajectories[i].back() == real_trajectories[j].back();
                    //    if (comp[0] && comp[1]) {
                    //        duplicate = true;
                    //        break;
                    //    }
                    //}
                    //if (duplicate) continue;

                    real_trajectories.push_back(all_trajectories[i]);
                    real_states.push_back(all_states[i]);
                }
            }
            all_trajectories = real_trajectories;
            all_states = real_states;

            old_sample_count = nb_samples;
            nb_samples = all_states.size();
            printf("Removed %ld invalid streamlines\n", old_sample_count - nb_samples);
            printf("Total of %ld samples being tracked.\n", nb_samples);
        }

        //Export data periodically
        if (current_target_time == next_export_time) {
            ++niter;
            _log_(0)
                << "Compute time this iteration: cpu: " << human_readable_duration(progress.cpu_time())
                    << " (" << progress.cpu_time() << " ms.) | wall: "
                << human_readable_duration(progress.wall_time())
                << " (" << progress.wall_time() << " ms.)\n";
			_log_(0) << "Interrupted trajectories: " << nb_lost << " (" << nb_lost*100/nb_samples << "%)" << std::endl;
            _log_(0) << "Overall compute time so far (" << niter << " iterations): cpu: ";

            double tcpu = total_progress.instant_cpu_time();
            double twal = total_progress.instant_wall_time();
             _log_(0)
                << human_readable_duration(tcpu) << " (" << tcpu << " ms.) | wall: "
                << human_readable_duration(twal) << " (" << twal << " ms.)"
                << std::endl;
        }

        if (current_target_time == t_max) break;
        else if (current_target_time == current_t_max) {
            // we have reached the end of the data currently available in
            // RAM. Import next time section.
            // [last_time_step-2*R, last_time_step-2*R+nslices-1]
            //printf("Importing file(s) set: %ld\n", last_time_step - 2 * support_radius);
            printf("Last time step: %ld Support radius: %ld\n", last_time_step, support_radius);
            import_data(velocity_filenames, vorticity_filenames,
                        last_time_step-2*support_radius);
            for (int i=0; i<nb_threads; ++i) {
                vf_copies[i] = shared_ptr< NrrdVectorField >(new NrrdVectorField(current_velocity_volume, std::string("velocity volume for thread #") + std::to_string(i), false));
                rhs_copies[i] = shared_ptr< NrrdODERHS >(new NrrdODERHS(*vf_copies[i], sample_counter[i], domain, max_rhs_evals));
            }
        }
        if (current_target_time == next_export_time) {
            std::clock_t loop_clock_end=std::clock();
            auto loop_timer_end = std::chrono::high_resolution_clock::now();
            export_results(next_export_time,
                           std::chrono::duration<double, std::milli>(loop_timer_end-loop_timer_start).count(),
                           1000.*(loop_clock_end-loop_clock_begin)/CLOCKS_PER_SEC, false);
            next_export_time += t_export_step;
            if (next_export_time > t_max) next_export_time = t_max;
        }
        // advance starting time
        current_start_time = current_target_time;
        _log_(1) << "current start time=" << current_start_time << std::endl;
        printf("End of iteration\n");
    }
    //printf("Exiting\n");
    std::clock_t clock_end=std::clock();
    auto timer_end = std::chrono::high_resolution_clock::now();
    export_results(t_max, std::chrono::duration<double, std::milli>(timer_end-timer_start).count(),
                   1000.*(clock_end-clock_begin)/CLOCKS_PER_SEC, true);

    //return 0;
    printf("Global ID set at: %d\n", global_identifier);

    //BACKWARDS INTEGRATE
    current_start_time += t_export_step;
    if (current_start_time > t_max) current_start_time = t_max;
    printf("Preparing for backwards integration of %d particles\n", global_identifier);
    std::vector<int> birth_times(global_identifier, 0);
    std::vector<double> initial_values(global_identifier, 0);
    all_trajectories.resize(global_identifier);
    all_states.resize(global_identifier);
    //printf("A\n");

    for (size_t i = 0; i < all_trajectories.size(); i++) {
        all_trajectories[i].clear();
        all_trajectories[i].push_back(nvis::vec2(0, 0));
        all_states[i].m_stopped = false;
        all_states[i].m_acc_vd = 0;
        all_states[i].meta_lifetime = 0;
        all_states[i].unique_id = i;
        all_states[i].birth_time = 0;
    }
    //printf("B\n");

    value_t final_timestep = 0;
    bool found_restart = false;
    //Restart from where we left off if applicable
    
    for (int i = 0; i < current_start_time / spurt::lavd::HOUR; i++) {
        std::ostringstream oss;
        oss << name_out << "_BACKWARDS" << "_fmap+lavd_" << std::setw(5) << std::setfill('0') << i << "h.nrrd";
        restart_name = oss.str();
        Nrrd* nin;
        try {
            //printf("Attempting to read %s\n", restart_name.c_str());
            nin = spurt::nrrd_utils::readNrrd(restart_name);
            std::string file_name;
            file_name = restart_name;
            file_name.insert(file_name.size() - 5, "2");
            //printf("%s\n", file_name.c_str());
            Nrrd* nin2 = spurt::nrrd_utils::readNrrd(file_name);
            spurt::nrrd_utils::to_vector(restart_values2, nin2);
            //printf("Reading from %s\n", restart_name.c_str());
            nrrdNuke(nin2);
        }
        catch (...) {
            continue;
        }

        spurt::nrrd_utils::to_vector(restart_values, nin);
        //if (restart_values.size() / 6 != all_states.size()) {
        //    printf("%ld v %ld\n", restart_values.size() / 6, all_states.size());
        //    nrrdNuke(nin);
        //    continue;
        //}
        for (size_t j = 0; j < restart_values.size() / 3; j++) {
                //printf("%ld: %d\n", i, id);
                //birth_times[id] = exported_hour * spurt::lavd::HOUR;
                initial_values[j] = restart_values[3 * j + 2];
                all_trajectories[j].push_back(nvis::vec2(restart_values[3 * j], restart_values[3 * j + 1]));
                //May need more state information?
                all_states[j].m_acc_vd = restart_values[3 * j + 2];

                all_states[j].meta_lifetime = restart_values2[3 * j];
                all_states[j].unique_id = restart_values2[3 * j + 1];
                all_states[j].birth_time = restart_values2[3 * j + 2];
                all_states[j].m_time = restart_values2[3 * j + 2];
                all_states[j].m_acc_time = restart_values2[3 * j + 2];
                all_states[j].m_pos[0] = restart_values[3 * j];
                all_states[j].m_pos[1] = restart_values[3 * j + 1];
        }
        final_timestep = i * spurt::lavd::HOUR;
        printf("Restarting from %s\n", restart_name.c_str());
        nrrdNuke(nin);
        //Update current volumes
        current_t_min = i * t_export_step / 3;
        current_t_min -= (nslices - 7) * t_export_step;                                                     //(nslices - 2) * t_export_step ???
        printf("Current_t_min: %lf\n", current_t_min);
        t_init = 0;
        import_data(velocity_filenames, vorticity_filenames, current_t_min / t_export_step);
        for (int i = 0; i < nb_threads; ++i) {
            vf_copies[i] = shared_ptr< NrrdVectorField >(new NrrdVectorField(current_velocity_volume, std::string("velocity volume for thread #") + std::to_string(i), false));
            rhs_copies[i] = shared_ptr< NrrdODERHS >(new NrrdODERHS(*vf_copies[i], sample_counter[i], domain, max_rhs_evals));
        }
        break;
    }
    

    if (final_timestep == 0) {
        //Import all particles from ourput files. Only import particles when they are born
        //Restart_values is a double. Problem?
        int exported_hour = current_start_time / spurt::lavd::HOUR;
        printf("Initial testing hour: %d\n", exported_hour);
        int total_imported = 0;
        while (exported_hour > 0) {
            std::ostringstream oss;
            //oss << "/mnt/d/1024x1024/Backwards/ForwardPass/raw/" << name_out << "_fmap+lavd_" << std::setw(5) << std::setfill('0') << exported_hour << "h.nrrd";
            oss << "/mnt/d/1024x1024/Split/raw/" << name_out << "_fmap+lavd_" << std::setw(5) << std::setfill('0') << exported_hour << "h.nrrd";
            //oss << "./" << name_out << "_fmap+lavd_" << std::setw(5) << std::setfill('0') << exported_hour << "h.nrrd";
            //oss << "/mnt/d/1024x1024/TEST/Recovery/No interruption/" << name_out << "_fmap+lavd_" << std::setw(5) << std::setfill('0') << exported_hour << "h.nrrd";
            restart_name = oss.str();
            Nrrd* nin;
            try {
                //printf("Attempting to read %s\n", restart_name.c_str());
                nin = spurt::nrrd_utils::readNrrd(restart_name);
                std::string file_name;
                file_name = restart_name;
                file_name.insert(file_name.size() - 5, "2");
                //printf("%s\n", file_name.c_str());
                Nrrd* nin2 = spurt::nrrd_utils::readNrrd(file_name);
                spurt::nrrd_utils::to_vector(restart_values2, nin2);
                printf("Reading from %s\n", restart_name.c_str());
                nrrdNuke(nin2);
            }
            catch (...) {
                exported_hour -= 3;
                continue;
            }
            if (final_timestep == 0) {
                final_timestep = exported_hour * spurt::lavd::HOUR;
            }
            spurt::nrrd_utils::to_vector(restart_values, nin);
            int count = 0;
            //printf("Reading from %s\n", restart_name.c_str());
            for (size_t i = 0; i < restart_values.size() / 3; i++) {
                if (restart_values2[3 * i] == 0) {                                                     //Import only what is needed
                //if(all_trajectories[static_cast<int>(restart_values[6 * i + 4])].size() == 1){                //Import all results
                    
                    //It is newly created this time step
                    int id = restart_values2[3 * i + 1];
                    //if (id == 500000) printf("i vs id: %ld vs %d\n", i, id);
                    //printf("id: %d\n", id);
                    //printf("%ld: %d\n", i, id);
                    birth_times[id] = exported_hour * spurt::lavd::HOUR;
                    initial_values[id] = restart_values[3 * i + 2];
                    //printf("X: %d\n", id);
                    //printf("%lf\n", restart_values[6 * i + 4]);
                    all_trajectories[id].push_back(nvis::vec2(restart_values[3 * i], restart_values[3 * i + 1]));
                    //if (id == 500000) printf("%lf, %lf\n", restart_values[6 * i], restart_values[6 * i + 1]);
                    //printf("Y: %ld\n", all_trajectories.size());
                    //May need more state information?
                    all_states[id].m_acc_vd = restart_values[3 * i + 2];
                    all_states[id].meta_lifetime = restart_values2[3 * i];
                    all_states[id].unique_id = restart_values2[3 * i + 1];
                    all_states[id].birth_time = restart_values2[3 * i + 2];
                    all_states[id].m_time = restart_values2[3 * i + 2];
                    all_states[id].m_acc_time = restart_values2[3 * i + 2];
                    all_states[id].m_pos[0] = restart_values[3 * i];
                    all_states[id].m_pos[1] = restart_values[3 * i + 1];
                    count++;
                    
                }
            }
            //printf("Imported %d new particles from %s\n", count, restart_name.c_str());
            total_imported += count;
            exported_hour -= 3;
            nrrdNuke(nin);
        }
        printf("Imported %d particles in total\n", total_imported);
    }
    //printf("C\n");

    t_init = 0;
    name_out.append("_BACKWARDS");
    backwards_verification(velocity_filenames, vorticity_filenames, final_timestep);

    return 0;
}
